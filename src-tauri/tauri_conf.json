{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kapatma Zamanlayıcı",
  "version": "0.1.0",
  "identifier": "com.kapatmazamanlayici.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kapatma Zamanlayıcı",
        "width": 760,
        "height": 460,
        "minWidth": 760,
        "minHeight": 460,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "icon": "icons/icon.ico"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
